# 环境变量配置示例文件
# 复制此文件为 .env.local 并填入实际值

# 基础 API 地址
VITE_API_BASE_URL=http://localhost:3000

# 聊天 API 地址
VITE_CHAT_API_BASE_URL=https://visual.volcengineapi.com

# 火山引擎 API 认证配置
VITE_CHAT_API_ACCESS_KEY_ID=your_access_key_id_here
VITE_CHAT_API_SECRET_ACCESS_KEY=your_secret_access_key_here

# API 基础配置
VITE_CHAT_API_BASE_URL=https://visual.volcengineapi.com
VITE_CHAT_API_ACTION=CVSync2AsyncSubmitTask
VITE_CHAT_API_VERSION=2022-08-31
VITE_CHAT_API_REQ_KEY=jimeng_ti2v_v30_pro

# 应用配置
VITE_APP_TITLE=AIGC Assistant

# 其他自定义变量...
